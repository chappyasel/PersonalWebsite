{
  "name": "personal-website",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "yarn@1.22.22",
  "scripts": {
    "prebuild": "bash scripts/fetch-dad-content.sh",
    "build": "next build",
    "db:generate": "drizzle-kit generate",
    "db:migrate:dev": "dotenv -e .env.development.local -- drizzle-kit migrate",
    "db:migrate:prod": "drizzle-kit migrate",
    "db:push:dev": "dotenv -e .env.development.local -- drizzle-kit push",
    "db:push:prod": "drizzle-kit push",
    "db:studio:dev": "dotenv -e .env.development.local -- drizzle-kit studio",
    "db:studio:prod": "drizzle-kit studio",
    "dev": "next dev --turbo",
    "fix": "eslint --fix \"src/**/*.{js,jsx,ts,tsx}\"",
    "fix:last": "eslint --fix $(git diff --name-only HEAD | grep -E '\\.(js|jsx|ts|tsx)$' | head -n 1)",
    "lint": "eslint \"src/**/*.{js,jsx,ts,tsx}\"",
    "start": "next start",
    "generate:blog-posts": "npx tsx ./scripts/generate/blog-posts.ts",
    "generate:manual": "npx tsx ./scripts/generate/manual.ts",
    "generate:routine": "npx tsx ./scripts/generate/routine.ts",
    "add-book-covers": "npx tsx ./scripts/add-book-covers.ts",
    "add-book-covers:dry-run": "npx tsx ./scripts/add-book-covers.ts --dry-run",
    "add-book-lengths": "npx tsx ./scripts/add-book-lengths.ts",
    "add-book-lengths:dry-run": "npx tsx ./scripts/add-book-lengths.ts --dry-run",
    "takeout:login": "npx tsx ./scripts/takeout/login.ts",
    "takeout:drive-auth": "npx tsx ./scripts/takeout/drive-auth.ts",
    "takeout:request": "npx tsx ./scripts/takeout/request.ts",
    "takeout:approve": "npx tsx ./scripts/takeout/approve.ts",
    "takeout:refresh": "npx tsx ./scripts/takeout/refresh.ts",
    "test": "vitest run"
  },
