{
  "name": "personal-website",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": "24.x",
    "pnpm": "10.34.5"
  },
  "scripts": {
    "prepare": "node scripts/install-git-hooks.mjs",
    "prebuild": "bash scripts/fetch-dad-content.sh && pnpm generate:dad-search-index",
    "build": "next build",
    "postbuild": "pnpm check:search-boundary && pnpm check:weight-log-boundary",
    "check:weight-log-boundary": "node scripts/check-weight-log-boundary.mjs",
    "db:generate": "drizzle-kit generate",
    "db:migrate:dev": "dotenv -e .env.development.local -- drizzle-kit migrate",
    "db:migrate:prod": "drizzle-kit migrate",
    "db:push:dev": "dotenv -e .env.development.local -- drizzle-kit push",
    "db:push:prod": "drizzle-kit push",
    "db:studio:dev": "dotenv -e .env.development.local -- drizzle-kit studio",
    "db:studio:prod": "drizzle-kit studio",
    "dev": "node scripts/dev.mjs",
    "prototype:personality": "python3 scripts/import-personality-prototype.py && SKIP_ENV_VALIDATION=1 next dev --hostname 127.0.0.1 --port 3016",
    "fix": "eslint --fix \"src/**/*.{js,jsx,ts,tsx}\"",
    "fix:last": "eslint --fix $(git diff --name-only HEAD | grep -E '\\.(js|jsx|ts|tsx)$' | head -n 1)",
    "lint": "eslint --max-warnings 0 \"src/**/*.{js,jsx,ts,tsx}\"",
    "typegen": "SKIP_ENV_VALIDATION=1 next typegen",
    "typecheck": "pnpm typegen && tsc --noEmit",
    "verify": "node scripts/verify.mjs",
    "verify:artifacts": "pnpm check:home-og && pnpm check:about-boot && pnpm check:search-index",
    "start": "next start",
    "check:node-version": "node scripts/check-node-version.mjs",
    "report:test-source-reads": "node scripts/test-source-reads.mjs",
    "check:meadow": "tsx ./scripts/stacks-meadow-check.ts",
    "check:perches": "tsx ./scripts/stacks-perch-check.ts",
    "test:performance": "playwright test",
    "test:performance:safety": "playwright test tests/e2e/stacks-performance-harness.spec.ts --grep 'holds the Safety triangle budget'",
    "generate:blog-posts": "tsx ./scripts/generate/blog-posts.ts",
    "generate:search-index": "tsx ./scripts/generate/universal-search-index.ts",
    "generate:dad-search-index": "tsx ./scripts/generate/dad-search-index.ts",
    "check:search-index": "tsx ./scripts/generate/universal-search-index.ts --check",
    "check:search-boundary": "node ./scripts/check-universal-search-boundary.mjs",
    "generate:home-og": "node ./scripts/generate/home-og-scene.mjs",
    "generate:home-og:local": "node ./scripts/generate/home-og-local.mjs",
    "check:home-og": "node ./scripts/check-home-og-freshness.mjs",
    "check:home-og:staged": "node ./scripts/check-home-og-freshness.mjs --staged",
    "generate:about-boot": "tsx ./scripts/generate-about-boot-silhouettes.mjs",
    "check:about-boot": "tsx ./scripts/generate-about-boot-silhouettes.mjs --check",
    "generate:stacks-photo-variants": "node ./scripts/stacks-photo-variants.mjs",
    "generate:stacks-labels": "node ./scripts/stacks-labels.mjs",
    "generate:manual": "tsx ./scripts/generate/manual.ts",
    "generate:routine": "tsx ./scripts/generate/routine.ts",
    "generate:systems": "tsx ./scripts/generate/systems.ts",
    "generate:scene-objects": "tsx ./scripts/generate/scene-object-notes.ts",
    "generate:github": "tsx ./scripts/generate/github-activity.ts",
    "generate:globe-map": "tsx ./scripts/generate/globe-map.ts",
    "generate:aic-chapters": "tsx ./scripts/generate/aic-chapters.ts",
    "preview:favicons": "node ./scripts/favicon-previews.mjs",
    "add-book-covers": "tsx ./scripts/add-book-covers.ts",
    "add-book-covers:dry-run": "tsx ./scripts/add-book-covers.ts --dry-run",
    "backfill:book-flags": "dotenv -e .env -- tsx ./scripts/backfill-book-flags.ts",
    "backfill:book-flags:dry-run": "dotenv -e .env -- tsx ./scripts/backfill-book-flags.ts --dry-run",
    "backfill:book-colors": "dotenv -e .env -- tsx ./scripts/backfill-book-colors.ts",
    "backfill:book-colors:dry-run": "dotenv -e .env -- tsx ./scripts/backfill-book-colors.ts --dry-run",
    "add-book-lengths": "tsx ./scripts/add-book-lengths.ts",
    "add-book-lengths:dry-run": "tsx ./scripts/add-book-lengths.ts --dry-run",
    "takeout:login": "tsx ./scripts/takeout/login.ts",
    "takeout:drive-auth": "tsx ./scripts/takeout/drive-auth.ts",
    "takeout:request": "tsx ./scripts/takeout/request.ts",
    "takeout:approve": "tsx ./scripts/takeout/approve.ts",
    "takeout:refresh": "tsx ./scripts/takeout/refresh.ts",
    "youtube:backfill-metadata": "tsx ./scripts/backfill-youtube-metadata.ts",
    "youtube:backfill-channels": "tsx ./scripts/backfill-youtube-channels.ts",
    "youtube:score": "tsx ./scripts/score-youtube.ts",
    "youtube:evaluate-scores": "tsx ./scripts/evaluate-youtube-scores.ts",
    "test": "vitest run --exclude 'tests/e2e/**'"
  },
  "dependencies": {
    "@ai-sdk/openai": "^3.0.53",
    "@auth/drizzle-adapter": "^1.1.0",
    "@aws-sdk/client-s3": "^3.995.0",
    "@notionhq/client": "^5.6.0",
    "@phosphor-icons/react": "^2.1.10",
    "@radix-ui/react-accordion": "^1.2.12",
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-popover": "^1.1.19",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slot": "1.2.4",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@react-three/drei": "^10",
    "@react-three/fiber": "^9",
    "@react-three/postprocessing": "3.0.5",
    "@t3-oss/env-nextjs": "^0.13.11",
    "@tanstack/query-sync-storage-persister": "5.90.18",
    "@tanstack/react-query": "5.90.18",
    "@tanstack/react-query-persist-client": "5.90.18",
    "@trpc/client": "^11.0.0-rc.446",
    "@trpc/react-query": "^11.0.0-rc.446",
    "@trpc/server": "^11.0.0-rc.446",
    "ai": "^6.0.162",
    "cannon-es": "^0.20.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "drizzle-orm": "^0.30.10",
    "framer-motion": "^12.24.7",
    "geist": "^1.3.0",
    "gray-matter": "^4.0.3",
    "lucide-react": "^0.575.0",
    "next": "16.1.6",
    "next-auth": "^5.0.0-beta.30",
    "next-themes": "^0.4.6",
    "notion-to-md": "^3.1.9",
    "nuqs": "^2.8.6",
    "ogl": "^1.0.11",
    "p-queue": "^9.0.1",
    "postgres": "^3.4.4",
    "posthog-js": "^1.215.1",
    "postprocessing": "6.39.4",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-markdown": "^10.1.0",
    "react-photo-view": "^1.2.7",
    "react-virtuoso": "^4.18.1",
    "recharts": "2.15.4",
    "rehype-raw": "^7.0.0",
    "remark-gfm": "^4.0.1",
    "server-only": "^0.0.1",
    "sharp": "^0.33.4",
    "superjson": "^2.2.1",
    "tailwind-merge": "^3.4.0",
    "tailwindcss-animate": "^1.0.7",
    "three": "0.185.1",
    "three-stdlib": "2.36.1",
    "zod": "4.3.6",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@playwright/test": "1.60.0",
    "@resvg/resvg-js": "^2.6.2",
    "@tailwindcss/typography": "^0.5.19",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.6",
    "@trivago/prettier-plugin-sort-imports": "^4.3.0",
    "@types/d3-geo": "^3.1.1",
    "@types/node": "^24.13.3",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/three": "^0.185.4",
    "@types/topojson-client": "^3.1.5",
    "d3-geo": "^3.1.1",
    "dotenv": "^17.2.3",
    "drizzle-kit": "^0.21.4",
    "esbuild": "0.27.7",
    "eslint": "9.39.5",
    "eslint-config-next": "16.1.6",
    "eslint-plugin-drizzle": "^0.2.3",
    "google-auth-library": "10.6.2",
    "googleapis": "^171.4.0",
    "jsdom": "^26.1.0",
    "meshoptimizer": "1.1.1",
    "playwright": "^1.59.1",
    "polygon-clipping": "^0.15.7",
    "postcss": "8.4.47",
    "prettier": "^3.3.2",
    "prettier-plugin-tailwindcss": "^0.6.5",
    "satori": "^0.19.2",
    "tailwindcss": "^3.4.3",
    "tailwindcss-intersect": "^2.1.0",
    "tailwindcss-motion": "^1.0.1",
    "topojson-client": "^3.1.0",
    "tsx": "^4.19.1",
    "typescript": "^5.5.3",
    "typescript-eslint": "8.52.0",
    "vite": "8.1.4",
    "vitest": "^4.1.10",
    "world-atlas": "^2.0.2"
  },
  "ct3aMetadata": {
    "initVersion": "7.36.2"
  }
}
