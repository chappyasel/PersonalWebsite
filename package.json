{
  "name": "personal-website",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "yarn@1.22.22",
  "scripts": {
    "build": "next build",
    "db:generate": "drizzle-kit generate",
    "db:migrate:dev": "dotenv -e .env.development.local -- drizzle-kit migrate",
    "db:migrate:prod": "drizzle-kit migrate",
    "db:push:dev": "dotenv -e .env.development.local -- drizzle-kit push",
    "db:push:prod": "drizzle-kit push",
    "db:studio:dev": "dotenv -e .env.development.local -- drizzle-kit studio",
    "db:studio:prod": "drizzle-kit studio",
    "dev": "next dev --turbo",
    "fix": "eslint --fix \"src/**/*.{js,jsx,ts,tsx}\"",
    "fix:last": "eslint --fix $(git diff --name-only HEAD | grep -E '\\.(js|jsx|ts|tsx)$' | head -n 1)",
    "lint": "eslint \"src/**/*.{js,jsx,ts,tsx}\"",
    "start": "next start",
    "generate:blog-posts": "npx tsx ./scripts/generate/blog-posts.ts",
    "add-book-covers": "npx tsx ./scripts/add-book-covers.ts",
    "add-book-covers:dry-run": "npx tsx ./scripts/add-book-covers.ts --dry-run"
  },
  "dependencies": {
    "@auth/drizzle-adapter": "^1.1.0",
    "@notionhq/client": "^5.6.0",
    "@phosphor-icons/react": "^2.1.10",
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-switch": "^1.2.6",
    "@t3-oss/env-nextjs": "^0.10.1",
    "@tanstack/react-query": "^5.50.0",
    "@trpc/client": "^11.0.0-rc.446",
    "@trpc/react-query": "^11.0.0-rc.446",
    "@trpc/server": "^11.0.0-rc.446",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.30.10",
    "framer-motion": "^11.5.4",
    "geist": "^1.3.0",
    "lucide-react": "^0.562.0",
    "next": "^14.2.4",
    "next-auth": "^4.24.7",
    "notion-to-md": "^3.1.9",
    "nuqs": "^2.8.6",
    "p-queue": "^9.0.1",
    "postgres": "^3.4.4",
    "posthog-js": "^1.215.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^10.1.0",
    "server-only": "^0.0.1",
    "sharp": "^0.33.4",
    "superjson": "^2.2.1",
    "tailwind-merge": "^3.4.0",
    "tailwindcss-animate": "^1.0.7",
    "zod": "^3.23.3"
