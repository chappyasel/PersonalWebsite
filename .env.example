# Since the ".env" file is gitignored, you can use the ".env.example" file to
# build a new ".env" file when you clone the repo. Keep this file up-to-date
# when you add new variables to `.env`.

# This file will be committed to version control, so make sure not to have any
# secrets in it. If you are cloning this repo, create a copy of this file named
# ".env" and populate it with your secrets.

# When adding additional environment variables, the schema in "/src/env.js"
# should be updated accordingly.

# Drizzle
DATABASE_URL="postgresql://postgres:password@localhost:5432/personal-website"

# Next Auth
# You can generate a new secret on the command line with:
# openssl rand -base64 32
# https://next-auth.js.org/configuration/options#secret
NEXTAUTH_SECRET=""
NEXTAUTH_URL="http://localhost:3000"

# PostHog
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=
# Errors reach PostHog error tracking from production only. Set to 1 to send
# them from a dev server too, for example while testing an error path.
NEXT_PUBLIC_REPORT_DEV_ERRORS=

# Notion Integration
NOTION_API_KEY=
NOTION_BOOKS_DATABASE_ID=

# Cron Job Authentication
# Generate with: openssl rand -base64 32
CRON_SECRET=""

# Dad Journal Content
DAD_CONTENT_PASSWORD=""
GCS_SERVICE_ACCOUNT_KEY=""

# Vercel AI Gateway
AI_GATEWAY_API_KEY=""

# GitHub (optional)
# A token lets the Projects placard fetch live contribution and repository
# data. Fine-grained, no permissions needed; the owner's own token also
# counts private contributions. Without it the committed snapshot is shown.
GITHUB_TOKEN=""

# Personalities: development uses a separate local Postgres database.
# Production falls back to DATABASE_URL. Configure the canonical HTTPS origin
# only when ready to enable the route; preview deployments stay disabled.
PERSONALITIES_DATABASE_URL=""
PERSONALITIES_ORIGIN=""
# Used only by explicit migration/backup commands, never by the app.
PERSONALITIES_TARGET_DATABASE_URL=""

# Booking at /meet (optional). The page books through a Daybreak deployment's
# tokenless /book routes. Without DAYBREAK_BOOKING_URL it says booking isn't
# open. Set it to the deployment's .convex.site origin, or to `fixture` in
# development for canned open time (production ignores `fixture`). In the
# fixture, an "about" line containing "taken" answers 409 and one containing
# "limit" answers 429.
DAYBREAK_BOOKING_URL=""
# The Booking link /meet shows. Defaults to `meet`.
DAYBREAK_BOOKING_SLUG=""
# The deployment's BOOKING_PROXY_SECRET, so Daybreak limits bookings per
# visitor. Without it every booking counts against Daybreak's shared limit
# for direct callers.
BOOKING_PROXY_SECRET=""
# Cloudflare Turnstile. Development skips the check without them; production
# refuses to book without the secret.
TURNSTILE_SECRET_KEY=""
NEXT_PUBLIC_TURNSTILE_SITE_KEY=""
